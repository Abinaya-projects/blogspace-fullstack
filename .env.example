# BlogSpace Environment Variables

# Server Port (default 3000)
PORT=3000

# MongoDB Connection URI (Optional: If omitted, an embedded local document store with automatic persistence is used)
# Example: mongodb://localhost:27017/blogspace or MongoDB Atlas connection string
MONGODB_URI="mongodb://localhost:27017/blogspace"

# JWT Secret Key for token signing and verification
JWT_SECRET="blogspace_jwt_secret_super_secure_key_2026"

# GEMINI_API_KEY: Optional if AI capabilities are used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
